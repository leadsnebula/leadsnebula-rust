# Local environment example for Rust services
# Copy to .env.local and update values for local development

# API base for frontend / other services to call (production domain)
LEAD_API_BASE_URL=https://api.leadsnebula.com

# Database connection string (example)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# SSM fallback for PII decryption when SSM times out (e.g. local dev without AWS):
# Set these to avoid PII showing as N/A. Values must match SSM /leadsnebula/{env}/carina/encryption/*
# LEADSNEBULA_DEV_DETERMINISTIC_KEY=
# LEADSNEBULA_DEV_KEY_DERIVATION_SALT=

# Other required env vars (JWT, AWS, etc.) are documented in README.md
