# Local development environment variables
# Copy this file to .env.local and fill in your values
# .env.local is gitignored and will not be committed

# AWS SES Credentials for email sending
# Get these from your AWS IAM user with SES permissions
SES_ACCESS_KEY_ID=your_ses_access_key_id_here
SES_SECRET_ACCESS_KEY=your_ses_secret_access_key_here
SES_REGION=us-east-1

# Optional: Override environment (defaults to development)
# ENVIRONMENT=development

# Optional: Override SSM environment for SES (defaults to prod for development)
# SES_SSM_ENV=prod
